<TableDescription>
	<Name>InterfaceEffect</Name>
	<Type>TableDescription</Type>
	<Element>
		<Name>Name</Name>
		<Type>String</Type>
		</Element>
	<Element>
		<Name>Pause_Menu</Name>
		<Type>Element</Type>
		<Display_Name>Pause Menu</Display_Name>
		<Element>
			<Name>Tint</Name>
			<Type>Element</Type>
			<Element>
				<Name>TintColor</Name>
				<Type>Color</Type>
				<R>
					<Name>R</Name>
					<Type>Int</Type>
					<Default>255</Default>
					</R>
				<G>
					<Name>G</Name>
					<Type>Int</Type>
					<Default>255</Default>
					</G>
				<B>
					<Name>B</Name>
					<Type>Int</Type>
					<Default>255</Default>
					</B>
				</Element>
			<Element>
				<Name>Brightness</Name>
				<Type>Float</Type>
				<Default>1.0</Default>
				<MinValue>0</MinValue>
				<MaxValue>2</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			<Element>
				<Name>Contrast</Name>
				<Type>Float</Type>
				<Default>1.0</Default>
				<MinValue>0</MinValue>
				<MaxValue>2</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			<Element>
				<Name>SaturationLevel</Name>
				<Type>Float</Type>
				<Default>0.0</Default>
				<MinValue>0</MinValue>
				<MaxValue>2</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			</Element>
		<Element>
			<Name>Blur</Name>
			<Type>Element</Type>
			<Element>
				<Name>BlurRadius</Name>
				<Type>Float</Type>
				<Default>0</Default>
				<MinValue>0</MinValue>
				<MaxValue>100</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			</Element>
		<Element>
			<Name>Distortion</Name>
			<Type>Element</Type>
			<Element>
				<Name>DistortionBitmap</Name>
				<Type>Filename</Type>
				<Default>0.0</Default>
				<StartingPath>data</StartingPath>
				<ShowPreload>True</ShowPreload>
				</Element>
			<Element>
				<Name>MaxPixelOffset</Name>
				<Type>Float</Type>
				<Default>0.0</Default>
				<MinValue>0</MinValue>
				<MaxValue>100</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			<Element>
