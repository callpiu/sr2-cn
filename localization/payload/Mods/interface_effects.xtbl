				<Type>Float</Type>
				<Default>0.0</Default>
				<MinValue>0</MinValue>
				<MaxValue>2</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			<Element>
				<Name>DistortionScrollSpeed</Name>
				<Type>Float</Type>
				<Default>0.0</Default>
				<MinValue>-10</MinValue>
				<MaxValue>10</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			<Element>
				<Name>DistortionScrollAmplitude</Name>
				<Type>Float</Type>
				<Default>0.0</Default>
				<MinValue>-10</MinValue>
				<MaxValue>10</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			</Element>
		<Element>
			<Name>Camera</Name>
			<Type>Element</Type>
			<Element>
				<Name>FOV</Name>
				<Type>Float</Type>
				<Default>60</Default>
				<MinValue>5</MinValue>
				<MaxValue>180</MaxValue>
				<UseSlider>True</UseSlider>
				</Element>
			</Element>
		</Element>
